# Public HTTPS address of the stand (Mini App and bot webhook)
PUBLIC_URL=https://catalog.example.com
# Port for the stand's nginx on 127.0.0.1 (the host nginx with TLS proxies to it)
HTTP_PORT=8085

POSTGRES_USER=catalog
POSTGRES_PASSWORD=change-me
POSTGRES_DB=catalog

MINIO_ROOT_USER=minio-admin
MINIO_ROOT_PASSWORD=change-me-min-8-chars
# Separate MinIO user for the API (not root)
S3_ACCESS_KEY=catalog-api
S3_SECRET_KEY=change-me-min-8-chars

# Shared secret between bot and API for creating products
INTERNAL_API_TOKEN=change-me

# Token from @BotFather
BOT_TOKEN=
# Telegram user ids of admins, comma separated
ADMIN_IDS=
# Letters, digits, _ and - only
WEBHOOK_SECRET=change-me
# Optional Bot API relay, e.g. http://host.docker.internal:8086 (see deploy/host-nginx-telegram-relay.conf).
# Empty means direct https://api.telegram.org
TELEGRAM_API_BASE=
